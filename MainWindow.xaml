<Window x:Class="VoltageDividerTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voltage Divider Tool"
    Height="600" Width="680"
    MinHeight="600" MinWidth="680"
    Background="{DynamicResource BackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    Icon="icon.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar (Future use) -->
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="32" Height="32" Background="{DynamicResource AccentBrush}"
                        CornerRadius="6" Margin="0,0,0,30">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Voltage Divider Button -->
                    <Button x:Name="BtnModeDivider" Click="ChangeMode_Click" Tag="Divider"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeDivider" Height="54"
                            Background="{DynamicResource SelectedBrush}" CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="R" Foreground="{DynamicResource TextBrush}"
                                    FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="DIV" Foreground="{DynamicResource TextBrush}"
                                    FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"
                                    Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Parallel R Button -->
                    <Button x:Name="BtnModeParallel" Click="ChangeMode_Click" Tag="Parallel"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeParallel" Height="54" Background="Transparent"
                            CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="R"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="PAR"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Regulator IC Button -->
                    <Button x:Name="BtnModeRegulator" Click="ChangeMode_Click" Tag="Regulator"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeRegulator" Height="54" Background="Transparent"
                            CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IC"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"
                                    FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="REG"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Vnode Button -->
                    <Button x:Name="BtnModeVnode" Click="ChangeMode_Click" Tag="Vnode"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeVnode" Height="54" Background="Transparent"
                            CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="V"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="NODE"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Color Code Button -->
                    <Button x:Name="BtnModeColor" Click="ChangeMode_Click" Tag="ColorCode"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeColor" Height="54" Background="Transparent"
                            CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModeColorTitle" Text="R"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"
                                    FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TxtModeColorSub" Text="COLOR"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- SMD Code Button -->
                    <Button x:Name="BtnModeSmd" Click="ChangeMode_Click" Tag="SmdCode"
                        Background="Transparent" BorderThickness="0" Margin="0,1" Padding="0"
                        HorizontalContentAlignment="Stretch">
                        <Border x:Name="BorderModeSmd" Height="54" Background="Transparent"
                            CornerRadius="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="R"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="SMD"
                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <Button x:Name="BtnThemeToggle" Grid.Row="1" Click="ToggleTheme_Click"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" ToolTip="Toggle theme">
                    <Border x:Name="BorderThemeToggle" Height="54" Background="Transparent"
                        CornerRadius="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtThemeIcon" Text="â˜¾"
                                Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15"
                                FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtThemeLabel" Text="DARK"
                                Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8"
                                FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header and Language Switch -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="MainHeader" Text="TÃNH Cáº¦U PHÃ‚N ÃP"
                    Style="{StaticResource Header1}" HorizontalAlignment="Left"
                    VerticalAlignment="Center" FontSize="20"
                    Foreground="{DynamicResource AccentBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Button Click="BtnGitHub_Click" Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="0,0,16,0" Cursor="Hand" ToolTip="View on GitHub">
                        <Border Padding="12,0" Height="24" Background="{DynamicResource CardBrush}"
                            CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                            <TextBlock x:Name="TxtAbout" Text="ThÃ´ng tin"
                                Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                FontWeight="Bold" HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <Button x:Name="BtnLangVi" Click="SwitchLang_Click" Tag="vi"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0"
                        Cursor="Hand">
                        <Border Width="36" Height="24" Background="#CC0000" CornerRadius="4"
                            Opacity="0.8">
                            <TextBlock Text="VI" Foreground="White" FontSize="11" FontWeight="Bold"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <Button x:Name="BtnLangEn" Click="SwitchLang_Click" Tag="en"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                        Cursor="Hand">
                        <Border Width="36" Height="24" Background="#3C3B6E" CornerRadius="4"
                            Opacity="0.8">
                            <TextBlock Text="EN" Foreground="White" FontSize="11" FontWeight="Bold"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Dynamic Diagram -->
                <Border Grid.Column="0" Background="{DynamicResource DiagramSurfaceBrush}"
                    CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,20,0">
                    <Grid>
                        <Viewbox Stretch="Uniform" Margin="20">
                            <Canvas x:Name="CircuitCanvas" Width="250" Height="600" />
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Right Panel: Dynamic Inputs -->
                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="12"
                    Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                            Margin="0,0,-5,0">
                            <StackPanel x:Name="InputsStack" Margin="0,0,10,0">
                                <!-- Vin Row (Only for Divider) -->
                                <Grid x:Name="VinRow" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnCalcVin" Content="Vin"
                                        Style="{StaticResource CalcButton}" Click="BtnCalc_Click"
                                        Width="75" HorizontalAlignment="Left" />
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="InputVin"
                                            Style="{StaticResource ModernTextBox}" Text=""
                                            TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                        <Button Visibility="Collapsed" Click="Clear_Click"
                                            Content="âœ•" Foreground="#EF4444"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="16" Cursor="Hand" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Grid>

                                <!-- Divider Mode Containers -->
                                <StackPanel x:Name="DividerPanel">
                                    <StackPanel x:Name="DividerResistorsContainer">
                                        <!-- Dynamic Resistor Rows -->
                                    </StackPanel>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnAddResistorDivider"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnAddResistor_Click" Tag="Divider" Width="75"
                                            Height="20" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentBrush}" Cursor="Hand">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                                                Margin="0,-3,0,0" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="DividerResultsContainer" Margin="0,5,0,0">
                                        <!-- Dynamic Vout Results -->
                                    </StackPanel>
                                </StackPanel>

                                <!-- Parallel Mode Containers -->
                                <StackPanel x:Name="ParallelPanel" Visibility="Collapsed">
                                    <StackPanel x:Name="ParallelResistorsContainer">
                                        <!-- Dynamic Resistor Rows -->
                                    </StackPanel>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnAddResistorParallel"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnAddResistor_Click" Tag="Parallel" Width="75"
                                            Height="20" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentBrush}" Cursor="Hand">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                                                Margin="0,-3,0,0" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <Grid x:Name="RTotalRow" Margin="0,5,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcRTotal" Content="Rtotal"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputRTotal"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8"
                                                Tag="RTotal" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- Regulator Mode Container -->
                                <StackPanel x:Name="RegulatorPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcRegVref" Content="Vref"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVref"
                                                Style="{StaticResource ModernTextBox}" Text="1.25"
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcRegR1" Content="R1"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputRegR1"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcRegR2" Content="R2"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputRegR2"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcRegVout" Content="Vout"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputRegVout"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- Vnode Mode Container -->
                                <StackPanel x:Name="VnodePanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeV1" Content="V1"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeV1"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeV2" Content="V2"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeV2"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeR1" Content="R1"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeR1"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeR2" Content="R2"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeR2"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeR3" Content="R3"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeR3"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCalcVnodeV3" Content="Vnode"
                                            Style="{StaticResource CalcButton}"
                                            Click="BtnCalc_Click" Width="75"
                                            HorizontalAlignment="Left" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="InputVnodeV3"
                                                Style="{StaticResource ModernTextBox}" Text=""
                                                TextChanged="Input_TextChanged" Padding="10,8,30,8" />
                                            <Button Visibility="Collapsed" Click="Clear_Click"
                                                Content="âœ•" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- Color Code Mode Container -->
                                <StackPanel x:Name="ColorCodePanel" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <RadioButton x:Name="Rb4Band" Content="4 VÃ²ng"
                                            IsChecked="True"
                                            Foreground="{DynamicResource TextBrush}"
                                            Margin="0,0,15,0" Checked="BandToggle_Checked"
                                            Unchecked="BandToggle_Checked" />
                                        <RadioButton x:Name="Rb5Band" Content="5 VÃ²ng"
                                            Foreground="{DynamicResource TextBrush}"
                                            Margin="0,0,15,0" Checked="BandToggle_Checked"
                                            Unchecked="BandToggle_Checked" />
                                        <RadioButton x:Name="Rb6Band" Content="6 VÃ²ng"
                                            Foreground="{DynamicResource TextBrush}"
                                            Checked="BandToggle_Checked"
                                            Unchecked="BandToggle_Checked" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <TextBlock x:Name="TxtColorResult" Text="0 Î©" FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Margin="0,0,15,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock x:Name="TxtColorTolerance" Text="Â±0%"
                                                FontSize="16"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Margin="0,0,0,2" />
                                            <TextBlock x:Name="TxtColorTempCo" Text="100 ppm/K"
                                                FontSize="12"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Selected Colors Visual Indicator mapped internally -->
                                    <Grid x:Name="ColorBandsGrid" HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0">
                                        <!-- Buttons populated via C# to avoid 100+ lines of XAML
                                        boilerplate -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
